# Rootless pod for the Foundry VTT module.
#
# Port model (no dedicated IP required): the Foundry web/websocket server
# (container 30000) is published on the node loopback and fronted by Traefik on
# the configured host name. Everything Foundry serves (HTTP + WebSocket) goes
# through that single HTTPS host, so no extra node ports are needed.

[Unit]
Description=Foundry VTT pod
Requires=foundryvtt-app.service
Before=foundryvtt-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/foundryvtt.pid %t/foundryvtt.pod-id
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile %t/foundryvtt.pid \
    --pod-id-file %t/foundryvtt.pod-id \
    --name foundryvtt \
    --hostname ${FOUNDRY_CONTAINER_HOSTNAME} \
    --publish 127.0.0.1:${WEB_PORT}:30000 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/foundryvtt.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/foundryvtt.pod-id -t 30
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/foundryvtt.pod-id
PIDFile=%t/foundryvtt.pid
Type=forking

[Install]
WantedBy=default.target
