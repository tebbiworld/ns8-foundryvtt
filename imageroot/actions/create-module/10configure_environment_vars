# Seed the initial environment for a fresh Foundry VTT instance.

import os

import agent

# One allocated TCP port fronts the Foundry web/websocket server (container
# 30000) through Traefik on the configured host name.
tcp_ports = [p.strip() for p in os.environ.get("TCP_PORTS", "").split(",") if p.strip()]
web_port = tcp_ports[0] if tcp_ports else "30000"
agent.set_env("WEB_PORT", web_port)

# Foundry binds its license to the container hostname, so keep it stable across
# restarts by deriving it from the (immutable) module id.
agent.set_env("FOUNDRY_CONTAINER_HOSTNAME", os.environ["MODULE_ID"])

# Defaults for the settings that stay empty until the admin configures them.
agent.set_env("FOUNDRY_ADMIN_KEY", "")
agent.set_env("FOUNDRY_USERNAME", "")
agent.set_env("FOUNDRY_PASSWORD", "")
agent.set_env("FOUNDRY_RELEASE_URL", "")
agent.set_env("FOUNDRY_LICENSE_KEY", "")
agent.set_env("FOUNDRY_VERSION", "")
agent.set_env("TZ", "UTC")

agent.dump_env()
