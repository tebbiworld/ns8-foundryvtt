# Enable and (re)start the Foundry VTT pod. Restarting the pod unit cascades to
# the app container through the unit dependencies.

import subprocess

units = ["foundryvtt.service", "foundryvtt-app.service"]
subprocess.run(["systemctl", "--user", "enable", *units], check=True)
subprocess.run(["systemctl", "--user", "restart", "foundryvtt.service"], check=True)
