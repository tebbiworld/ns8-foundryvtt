# Up to 1.0.2 the secrets were stored with agent.set_env(), i.e. in
# state/environment, which the agent mirrors to Redis in plain text. Move them
# to state/passwords.env (0600); the values do not change.

import modsecrets

modsecrets.migrate_from_env(
    ["FOUNDRY_ADMIN_KEY", "FOUNDRY_PASSWORD", "FOUNDRY_LICENSE_KEY", "FOUNDRY_RELEASE_URL"])
